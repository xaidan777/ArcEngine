    },
    {
      "id": "blender",
      "repo": "blender/blender",
      "ref": "main",
      "stage": "render",
      "backend": "cpu",
      "note": "Installed from Ubuntu packages in cloud Actions; do not clone enormous source tree"
    },
    {
      "id": "arcengine",
      "repo": "kivnufki121-dot/ArcEngine",
      "ref": "main",
      "stage": "host",
      "backend": "host",
