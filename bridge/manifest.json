    },
    {
      "id": "unimate",
      "repo": "Friedrich-M/UniMate",
      "ref": "main",
      "stage": "animation",
      "backend": "gpu",
      "note": "Motion/skeleton generation, model weights required"
    },
    {
      "id": "ultratex",
      "repo": "visualbruno/ComfyUI-UltraTex",
      "ref": "main",
      "stage": "texture",
