{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/dev-server.mjs",
        "--port=9378",
        "--no-open"
      ],
      "port": 9378
    },
    {
      "name": "editor",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "_utils/editor/server.mjs",
        "--port=9377",
        "--no-open"
      ],
      "port": 9377
    },
    {
      "name": "online-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/main.mjs"
      ],
      "env": {
        "PORT": "8787",
        "CLIENT_ORIGIN": "http://127.0.0.1:9378",
        "ACCOUNTS_DIR": "./var/accounts"
      },
      "port": 8787
    }
  ]
}
